---
import Layout from '../layouts/Layout.astro';
import data from '../data/site.json';
export function getStaticPaths(){return data.routes.filter(x=>x.path!=='/').map(item=>({params:{path:decodeURIComponent(item.path.replace(/^\/|\/$/g,''))},props:{item}}));}
const {item}=Astro.props;
const comments=data.comments.filter(c=>c.post===item.id);
---
<Layout title={item.seoTitle||`${item.title} — Life as Sakti`} description={item.description} canonical={item.canonical} image={item.image} type={item.kind==='post'?'article':'website'} date={item.date} modified={item.modified}><section class="article-heading"><a class="eyebrow" href="/archive/">{item.kind==='post'?'FROM THE JOURNAL':'LIFE AS SAKTI'}</a><h1>{item.title}</h1>{item.dateLabel&&<p class="byline">Sakti · <time datetime={item.date}>{item.dateLabel}</time></p>}</section>{item.kind==='listing'?<section class="archive"><label for="search">Find an article</label><input id="search" type="search" placeholder="Search titles and topics…"/><p id="result-count" aria-live="polite"></p><div class="archive-list">{item.items.map(path=>{const p=data.posts.find(p=>p.path===path);return p&&<article data-search={`${p.title} ${p.categoryNames.join(' ')} ${p.description}`.toLowerCase()}><time datetime={p.date}>{p.dateLabel}</time><h2><a href={p.path}>{p.title}</a></h2><p>{p.description}</p></article>})}</div><p id="no-results" hidden>No articles found. Try another word.</p></section>:<><article class="prose" set:html={item.html}/>{item.categoryNames?.length>0&&<aside class="topics">Filed under {item.categoryNames.join(' · ')}</aside>}{comments.length>0&&<section class="comments"><h2>Reader reflections</h2><p class="muted">Comments preserved from the original publication.</p>{comments.map(c=><article><h3>{c.author}</h3><time>{c.date.slice(0,10)}</time><div set:html={c.html}/></article>)}</section>}<p class="back"><a href="/archive/">← Back to all writing</a></p></>}</Layout>
<script>const search=document.querySelector<HTMLInputElement>('#search');search?.addEventListener('input',()=>{const q=search.value.toLowerCase().trim();let count=0;document.querySelectorAll<HTMLElement>('[data-search]').forEach(el=>{el.hidden=!el.dataset.search?.includes(q);if(!el.hidden)count++;});document.querySelector('#result-count')!.textContent=`${count} articles`;document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;});</script>
