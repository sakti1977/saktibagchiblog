---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Reader insights — Life as Sakti"><section class="dashboard"><p class="eyebrow">PRIVATE DASHBOARD</p><h1>Reader insights</h1><form id="login"><label>Dashboard password<input name="password" type="password" required/></label><button class="button">Open dashboard</button></form><p id="message" aria-live="polite"></p><div id="results" hidden><h2>Article readership</h2><div class="table-wrap"><table><thead><tr><th>Article</th><th>Views</th><th>Readers</th><th>Likes</th></tr></thead><tbody id="pages"></tbody></table></div><h2>Comments awaiting approval</h2><div id="pending"></div></div></section></Layout>
<script>
 const form=document.querySelector<HTMLFormElement>('#login')!,message=document.querySelector('#message')!,results=document.querySelector<HTMLElement>('#results')!;const escape=(v:string)=>{const e=document.createElement('div');e.textContent=v;return e.innerHTML;};
 async function load(password:string){const auth='Basic '+btoa('admin:'+password),response=await fetch('/api/admin/summary',{headers:{Authorization:auth}});if(!response.ok){message.textContent='The password was not accepted.';return;}sessionStorage.setItem('engagement-password',password);const data=await response.json();message.textContent='';results.hidden=false;document.querySelector('#pages')!.innerHTML=data.pages.map((p:any)=>`<tr><td><a href="${p.path}">${escape(p.path)}</a></td><td>${p.views}</td><td>${p.visitors}</td><td>${p.likes}</td></tr>`).join('');document.querySelector('#pending')!.innerHTML=data.pending.length?data.pending.map((c:any)=>`<article data-id="${c.id}"><h3>${escape(c.name)}</h3><p><a href="${c.path}">${escape(c.path)}</a> · ${escape(c.email)}</p><p>${escape(c.body)}</p><button data-action="approve">Approve</button> <button data-action="delete">Delete</button></article>`).join(''):'<p>No comments are waiting.</p>';document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button=>button.addEventListener('click',async()=>{const article=button.closest<HTMLElement>('[data-id]')!;await fetch(`/api/admin/comments/${article.dataset.id}/${button.dataset.action}`,{method:'POST',headers:{Authorization:auth}});await load(password);}));}
 form.addEventListener('submit',event=>{event.preventDefault();load(new FormData(form).get('password') as string);});const saved=sessionStorage.getItem('engagement-password');if(saved)load(saved);
</script>
